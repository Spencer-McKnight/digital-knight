{
  "name": "digital-knight",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Knight",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,scss,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,scss,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff --linked --use-migra -f",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "db:sync-env": "node scripts/sync-supabase-env.mjs",
    "db:setup": "pnpm db:link && pnpm db:push && pnpm db:sync-env && pnpm db:types",
    "email:dev": "email dev --dir src/emails --port 3333"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@react-email/components": "^1.0.12",
    "@supabase/supabase-js": "^2.104.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "ics": "^3.11.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-email": "^6.0.0",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/expect": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "supabase": "^2.94.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
