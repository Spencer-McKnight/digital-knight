# =============================================================================
# Digital Knight — environment template
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development. Never commit `.env*.local`.
# Production values are set in Vercel.
# =============================================================================

# Public base URL — used by metadata, OG images, canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Let's Talk — booking
# ─────────────────────────────────────────────────────────────────────────────
# We point at a Supabase *cloud* project (no Docker, no local stack).
#
# Populate SUPABASE_* automatically after `pnpm db:link`:
#     pnpm db:sync-env
# or manually from the dashboard (Settings → API).

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend — transactional email for booking confirmations.
#   · Sign in at https://resend.com, create an API key, add your sender domain.
#   · BOOKING_FROM_EMAIL must be a verified sender on that domain.
RESEND_API_KEY=""
BOOKING_FROM_EMAIL="bookings@digital-knight.au"
BOOKING_HOST_EMAIL="hello@digital-knight.au"

# Meeting defaults — safe to keep as-is.
BUSINESS_TIMEZONE="Australia/Melbourne"
BOOKING_HORIZON_WEEKS="8"
BOOKING_HOST_NAME="Digital Knight"
BOOKING_HOST_DOMAIN="digital-knight.au"

# HMAC key that signs each free-slot token surfaced by getWeekAvailability.
# Required in production; dev falls back to a baked key with a loud warning.
#   Generate one:  openssl rand -hex 32
BOOKING_SLOT_SIGNING_KEY=""
